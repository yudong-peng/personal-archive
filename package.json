{
  "name": "personal-archive",
  "version": "0.3.0",
  "description": "离线个人档案库 · 网页界面桌面版",
  "main": "app/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "node scripts/build-win.cjs",
    "build:update": "node scripts/build-update.cjs",
    "check": "node scripts/check.cjs",
    "test:desktop": "node scripts/test-desktop.cjs",
    "package:release": "npm run build:win && npm run build:update && node scripts/zip-release.cjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "koffi": "3.3.3",
    "sql.js": "1.15.0"
  },
  "devDependencies": {
    "@electron/asar": "4.0.1",
    "@electron/get": "3.1.0",
    "electron": "44.9.0",
    "extract-zip": "2.0.1"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  }
}
